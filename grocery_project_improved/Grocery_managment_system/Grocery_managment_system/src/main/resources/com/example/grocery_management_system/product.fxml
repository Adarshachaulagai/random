<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" style="-fx-background-color: #0f1923; -fx-padding: 0;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.grocery_management_system.controller.ProductController">

    <!-- Page Header -->
    <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 4 0;">
        <VBox spacing="3">
            <Label text="Products" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f0f4f8;"/>
            <Label text="Manage your product inventory" style="-fx-font-size: 12; -fx-text-fill: #6b7fa3;"/>
        </VBox>
    </HBox>

    <!-- Search + Actions bar -->
    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: #1a2634; -fx-background-radius: 10; -fx-padding: 12 16; -fx-border-color: #2a3d52; -fx-border-radius: 10; -fx-border-width: 1;">
        <TextField fx:id="searchField" promptText="🔍  Search by name or category..." prefWidth="320" HBox.hgrow="ALWAYS"
                   style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-prompt-text-fill: #3d5068; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 9 14; -fx-font-size: 13;"/>
        <Button text="Search" onAction="#search"
                style="-fx-background-color: #00c896; -fx-text-fill: #0f1923; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand; -fx-font-size: 12;"/>
        <Button text="Refresh" onAction="#refresh"
                style="-fx-background-color: #2a3d52; -fx-text-fill: #a8b9cc; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand; -fx-font-size: 12;"/>
        <Button text="Delete Selected" onAction="#deleteSelected"
                style="-fx-background-color: rgba(255,107,107,0.12); -fx-text-fill: #ff6b6b; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand; -fx-font-size: 12; -fx-border-color: rgba(255,107,107,0.25); -fx-border-radius: 8; -fx-border-width: 1;"/>
        <Label text="● Red rows = low stock" style="-fx-text-fill: #ff6b6b; -fx-font-size: 11;"/>
    </HBox>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #1a2634; -fx-background-radius: 10; -fx-border-color: #2a3d52; -fx-border-radius: 10; -fx-border-width: 1; -fx-table-cell-border-color: #2a3d52;">
        <columns>
            <TableColumn fx:id="colID"       text="ID"          prefWidth="60"/>
            <TableColumn fx:id="colName"     text="Name"        prefWidth="220"/>
            <TableColumn fx:id="colCategory" text="Category"    prefWidth="130"/>
            <TableColumn fx:id="colPrice"    text="Price (Rs.)" prefWidth="110"/>
            <TableColumn fx:id="colQty"      text="Quantity"    prefWidth="100"/>
            <TableColumn fx:id="colMin"      text="Min Stock"   prefWidth="100"/>
        </columns>
        <placeholder>
            <Label text="No products found." style="-fx-text-fill: #6b7fa3; -fx-font-size: 13;"/>
        </placeholder>
    </TableView>

    <!-- Edit panel -->
    <VBox spacing="14" style="-fx-background-color: #1a2634; -fx-background-radius: 10; -fx-padding: 18 20; -fx-border-color: #2a3d52; -fx-border-radius: 10; -fx-border-width: 1;">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="✏️" style="-fx-font-size: 14;"/>
            <Label text="Edit Selected Product" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #f0f4f8;"/>
        </HBox>

        <GridPane hgap="14" vgap="12">
            <Label text="Name" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6b7fa3;"/>
            <TextField fx:id="editName" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="240"
                       style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8 12; -fx-font-size: 12;"/>
            <Label text="Category" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6b7fa3; -fx-padding: 0 0 0 16;"/>
            <TextField fx:id="editCategory" GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="180"
                       style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8 12; -fx-font-size: 12;"/>

            <Label text="Price" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6b7fa3;"/>
            <TextField fx:id="editPrice" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8 12; -fx-font-size: 12;"/>
            <Label text="Quantity" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6b7fa3; -fx-padding: 0 0 0 16;"/>
            <TextField fx:id="editQty" GridPane.rowIndex="1" GridPane.columnIndex="3"
                       style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8 12; -fx-font-size: 12;"/>

            <Label text="Min Stock" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6b7fa3;"/>
            <TextField fx:id="editMin" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8 12; -fx-font-size: 12;"/>
        </GridPane>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="Save Changes" onAction="#saveEdit"
                    style="-fx-background-color: #00c896; -fx-text-fill: #0f1923; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 22; -fx-cursor: hand; -fx-font-size: 12;"/>
            <Label fx:id="statusLabel" text="" style="-fx-text-fill: #00c896; -fx-font-size: 12;"/>
        </HBox>
    </VBox>
</VBox>
