<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" style="-fx-background-color: #0f1923; -fx-padding: 0;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.grocery_management_system.controller.TodaySalesController">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Today's Sales" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f0f4f8;"/>
            <Label text="All transactions recorded today" style="-fx-font-size: 12; -fx-text-fill: #6b7fa3;"/>
        </VBox>
        <Button text="↻  Refresh" onAction="#refresh"
                style="-fx-background-color: #2a3d52; -fx-text-fill: #a8b9cc; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand; -fx-font-size: 12;"/>
    </HBox>

    <!-- Summary card -->
    <HBox style="-fx-background-color: rgba(0,200,150,0.08); -fx-background-radius: 10; -fx-padding: 14 18; -fx-border-color: rgba(0,200,150,0.25); -fx-border-radius: 10; -fx-border-width: 1;" spacing="10" alignment="CENTER_LEFT">
        <Label text="📊" style="-fx-font-size: 16;"/>
        <Label fx:id="summaryLabel" text="" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #00c896;"/>
    </HBox>

    <TableView fx:id="salesTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #1a2634; -fx-background-radius: 10; -fx-border-color: #2a3d52; -fx-border-radius: 10; -fx-border-width: 1; -fx-table-cell-border-color: #2a3d52;">
        <columns>
            <TableColumn fx:id="colID"    text="Sale ID"     prefWidth="100"/>
            <TableColumn fx:id="colDate"  text="Date / Time" prefWidth="240"/>
            <TableColumn fx:id="colTotal" text="Total (Rs.)" prefWidth="160"/>
            <TableColumn fx:id="colUser"  text="Cashier"     prefWidth="180"/>
        </columns>
        <placeholder>
            <Label text="No sales recorded today yet." style="-fx-text-fill: #6b7fa3; -fx-font-size: 13;"/>
        </placeholder>
    </TableView>
</VBox>
