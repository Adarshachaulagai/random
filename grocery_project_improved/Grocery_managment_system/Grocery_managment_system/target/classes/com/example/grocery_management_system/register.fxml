<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.grocery_management_system.controller.RegisterController"
           style="-fx-background-color: #0f1923;">

    <VBox alignment="CENTER" spacing="0" maxWidth="420"
          style="-fx-background-color: #1a2634; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 32, 0, 0, 8);">

        <HBox style="-fx-background-color: #00c896; -fx-background-radius: 16 16 0 0; -fx-pref-height: 5; -fx-min-height: 5;"/>

        <VBox spacing="18" style="-fx-padding: 44 40 44 40;">
            <VBox alignment="CENTER" spacing="6">
                <Label text="🛒" style="-fx-font-size: 32;"/>
                <Label text="Create Account" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f0f4f8;"/>
                <Label text="Join Grocery Management System" style="-fx-font-size: 12; -fx-text-fill: #6b7fa3;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="USERNAME" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6b7fa3;"/>
                <TextField fx:id="usernameField" promptText="Minimum 3 characters"
                           style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-prompt-text-fill: #3d5068; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="PASSWORD" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6b7fa3;"/>
                <PasswordField fx:id="passwordField" promptText="Create a strong password"
                               style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-prompt-text-fill: #3d5068; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13;"/>
                <Label text="Min 6 chars · 1 uppercase · 1 number · 1 special char (@#!$...)"
                       style="-fx-font-size: 11; -fx-text-fill: #3d5068;" wrapText="true" maxWidth="340"/>
            </VBox>

            <VBox spacing="6">
                <Label text="CONFIRM PASSWORD" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6b7fa3;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password"
                               style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-prompt-text-fill: #3d5068; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13;"/>
            </VBox>

            <Label fx:id="messageLabel" text="" wrapText="true" maxWidth="340"
                   style="-fx-text-fill: #ff6b6b; -fx-font-size: 12; -fx-background-color: rgba(255,107,107,0.08); -fx-background-radius: 6; -fx-padding: 8 12;"/>

            <Button text="Create Account" onAction="#register" prefWidth="340" defaultButton="true"
                    style="-fx-background-color: #00c896; -fx-text-fill: #0f1923; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>

            <HBox alignment="CENTER" spacing="8">
                <Label text="Already have an account?" style="-fx-text-fill: #6b7fa3; -fx-font-size: 12;"/>
                <Button text="Sign In" onAction="#goToLogin"
                        style="-fx-background-color: transparent; -fx-text-fill: #00c896; -fx-font-size: 12; -fx-cursor: hand; -fx-underline: true; -fx-padding: 0;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
