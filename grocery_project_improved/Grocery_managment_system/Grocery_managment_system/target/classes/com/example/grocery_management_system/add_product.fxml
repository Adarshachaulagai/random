<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-background-color: #0f1923; -fx-padding: 0;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.grocery_management_system.controller.AddProductController"
      maxWidth="560">

    <VBox spacing="3">
        <Label text="Add New Product" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f0f4f8;"/>
        <Label text="Fill in the product details below" style="-fx-font-size: 12; -fx-text-fill: #6b7fa3;"/>
    </VBox>

    <VBox spacing="20" style="-fx-background-color: #1a2634; -fx-background-radius: 12; -fx-padding: 28 24; -fx-border-color: #2a3d52; -fx-border-radius: 12; -fx-border-width: 1;">

        <GridPane hgap="20" vgap="18">

            <VBox GridPane.rowIndex="0" GridPane.columnIndex="0" spacing="6">
                <Label text="PRODUCT NAME *" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6b7fa3;"/>
                <TextField fx:id="nameField" promptText="e.g. Rice 5kg" prefWidth="260"
                           style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-prompt-text-fill: #3d5068; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13;"/>
            </VBox>

            <VBox GridPane.rowIndex="0" GridPane.columnIndex="1" spacing="6">
                <Label text="CATEGORY" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6b7fa3;"/>
                <TextField fx:id="categoryField" promptText="e.g. Grains (leave blank for General)"
                           style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-prompt-text-fill: #3d5068; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13;"/>
            </VBox>

            <VBox GridPane.rowIndex="1" GridPane.columnIndex="0" spacing="6">
                <Label text="PRICE (Rs.) *" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6b7fa3;"/>
                <TextField fx:id="priceField" promptText="e.g. 150.00"
                           style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-prompt-text-fill: #3d5068; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13;"/>
            </VBox>

            <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="6">
                <Label text="QUANTITY *" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6b7fa3;"/>
                <TextField fx:id="quantityField" promptText="e.g. 50"
                           style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-prompt-text-fill: #3d5068; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13;"/>
            </VBox>

            <VBox GridPane.rowIndex="2" GridPane.columnIndex="0" spacing="6">
                <Label text="MIN STOCK *" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6b7fa3;"/>
                <TextField fx:id="minStockField" promptText="Alert when qty falls below this"
                           style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-prompt-text-fill: #3d5068; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10 14; -fx-font-size: 13;"/>
            </VBox>
        </GridPane>

        <Label fx:id="messageLabel" text="" wrapText="true" maxWidth="480"
               style="-fx-text-fill: #ff6b6b; -fx-font-size: 12; -fx-background-color: rgba(255,107,107,0.08); -fx-background-radius: 6; -fx-padding: 8 14;"/>

        <HBox spacing="12">
            <Button text="Add Product" onAction="#addProduct"
                    style="-fx-background-color: #00c896; -fx-text-fill: #0f1923; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 8; -fx-padding: 11 28; -fx-cursor: hand;"/>
            <Button text="Clear Fields" onAction="#clearFields"
                    style="-fx-background-color: #2a3d52; -fx-text-fill: #a8b9cc; -fx-font-size: 13; -fx-background-radius: 8; -fx-padding: 11 22; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</VBox>
