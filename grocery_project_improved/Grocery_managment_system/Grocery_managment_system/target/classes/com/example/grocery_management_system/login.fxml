<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.grocery_management_system.controller.LoginController"
           style="-fx-background-color: #0f1923;">

    <VBox alignment="CENTER" spacing="0" maxWidth="400"
          style="-fx-background-color: #1a2634; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 32, 0, 0, 8);">

        <!-- Header accent bar -->
        <HBox style="-fx-background-color: #00c896; -fx-background-radius: 16 16 0 0; -fx-pref-height: 5; -fx-min-height: 5;"/>

        <VBox spacing="20" style="-fx-padding: 48 40 44 40;">
            <!-- Logo area -->
            <VBox alignment="CENTER" spacing="6">
                <Label text="🛒" style="-fx-font-size: 36;"/>
                <Label text="Grocery Management" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f0f4f8;"/>
                <Label text="Sign in to your account" style="-fx-font-size: 13; -fx-text-fill: #6b7fa3;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="USERNAME" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6b7fa3; -fx-letter-spacing: 1;"/>
                <TextField fx:id="usernameField" promptText="Enter your username"
                           style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-prompt-text-fill: #3d5068; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 11 14; -fx-font-size: 13;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="PASSWORD" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6b7fa3; -fx-letter-spacing: 1;"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                               style="-fx-background-color: #0f1923; -fx-background-radius: 8; -fx-text-fill: #f0f4f8; -fx-prompt-text-fill: #3d5068; -fx-border-color: #2a3d52; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 11 14; -fx-font-size: 13;"/>
            </VBox>

            <Label fx:id="messageLabel" text="" wrapText="true" maxWidth="320"
                   style="-fx-text-fill: #ff6b6b; -fx-font-size: 12; -fx-background-color: rgba(255,107,107,0.08); -fx-background-radius: 6; -fx-padding: 8 12;"/>

            <Button text="Sign In" onAction="#login" prefWidth="320" defaultButton="true"
                    style="-fx-background-color: #00c896; -fx-text-fill: #0f1923; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>

            <HBox alignment="CENTER" spacing="8" style="-fx-padding: 4 0 0 0;">
                <Label text="Don't have an account?" style="-fx-text-fill: #6b7fa3; -fx-font-size: 12;"/>
                <Button text="Create Account" onAction="#goToRegister"
                        style="-fx-background-color: transparent; -fx-text-fill: #00c896; -fx-font-size: 12; -fx-cursor: hand; -fx-underline: true; -fx-padding: 0;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
